{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "music-hub-cdn",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-24",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "vars": {
    "ORIGIN_URL": "https://sample-song-list-activity.onrender.com"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
